{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9ma0-bank.local/schemas/question.schema.json",
  "title": "Question",
  "description": "One past-paper question (or part) from Edexcel A-level Maths 9MA0. Unknown values are null, never invented.",
  "$ref": "#/$defs/core",
  "properties": {
    "id": {
      "description": "Unique id, e.g. 9MA0-01_2023-06_Q07b.",
      "pattern": "^9MA0-0[1-3]_[0-9]{4}-(0[1-9]|1[0-2])_Q[0-9]{1,2}[a-z]?$"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "core": {
      "type": "object",
      "required": [
        "id", "paper", "series", "question", "topic", "spec_ref", "marks",
        "question_latex", "mark_scheme", "examiner_notes", "difficulty",
        "has_diagram", "source_page"
      ],
      "properties": {
        "id": {
          "description": "Unique id. Its exact pattern is set by each top-level schema.",
          "type": "string",
          "minLength": 1
        },
        "paper": {
          "description": "Paper code.",
          "enum": ["9MA0-01", "9MA0-02", "9MA0-03"]
        },
        "series": {
          "description": "Exam series as YYYY-MM.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "question": {
          "description": "Question label as printed, e.g. \"7\" or \"7(b)\".",
          "type": "string",
          "minLength": 1
        },
        "topic": { "type": ["string", "null"], "minLength": 1 },
        "spec_ref": {
          "description": "Specification reference, e.g. \"7.3\".",
          "type": ["string", "null"]
        },
        "marks": { "type": ["integer", "null"], "minimum": 1 },
        "question_latex": { "type": ["string", "null"] },
        "mark_scheme": {
          "description": "Mark points exactly as in the published mark scheme, e.g. \"M1: ...\". Null if not available.",
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "examiner_notes": {
          "description": "Comments from the examiner report. Null if none found.",
          "type": ["string", "null"]
        },
        "difficulty": { "enum": ["easy", "medium", "hard", null] },
        "has_diagram": { "type": ["boolean", "null"] },
        "source_page": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
